# Copy to ~/engram/.env (then `chmod 600 ~/engram/.env`) — on native ext4, NOT in the repo
# (the repo is a v9fs Windows mount; chmod doesn't stick there). Never commit a real .env.
ENGRAM_DB=$HOME/engram/data/engram.db
# Loopback bind: LAN exposure is via the reverse tunnel to gateway-host + the litellm /engram pass-through.
ENGRAM_BIND=127.0.0.1:8088
ENGRAM_TOKEN=
# litellm gateway (embeddings + LLM). ENGRAM_GATEWAY_KEY = the gateway LITELLM_MASTER_KEY (from gateway-host).
ENGRAM_GATEWAY_URL=http://127.0.0.1:4000
ENGRAM_GATEWAY_KEY=
# ENGRAM_EMBED_URL=  # send embeddings to a different backend (e.g. local Ollama) while LLM stays on the gateway
ENGRAM_AUDIT_URL=http://127.0.0.1:8383
ENGRAM_EMBED_MODEL=mxbai-embed-large
ENGRAM_EMBED_DIM=1024
# ENGRAM_EMBED_TIMEOUT_SECS=30  # embed HTTP request timeout in seconds
# ENGRAM_CODE_SYMBOL_SPLIT=true  # code chunking flushes at definition boundaries (Phase F)
# ENGRAM_CODE_PATH_PRIOR=true    # down-weight docs/tests/config in code-search ranking (Phase F)
# ENGRAM_EMBED_FALLBACK=false    # wrap the gateway embedder with a local Ollama fallback (Phase R)
# ENGRAM_OLLAMA_URL=http://127.0.0.1:11434  # fallback Ollama endpoint (used when EMBED_FALLBACK=true)
# ENGRAM_CONSOLIDATE_CODE=false  # run consolidation on code docs (trees unread until Phase 2) (Phase R)
# ENGRAM_CODE_TREE_SITTER=true   # tree-sitter boundary chunking + AST symbols (Phase 4)
# ENGRAM_CODE_MIN_SCORE=0.0      # search_code abstention floor: drop hits below this score (0 = off)
# ENGRAM_CODE_NATIVE_PACK=false  # pack consecutive C/C++ defs into wider boundary-aligned chunks
# ENGRAM_CODE_NATIVE_BUDGET=480 # token budget for native packing (raise ~1500 with a long-context embedder)
# ENGRAM_CODE_KEYWORD_IDF=true   # IDF-weighted keyword in search_code (rare terms dominate ranking)
# ENGRAM_CODE_KW_WEIGHT=0.50       # keyword weight in search_code blend (vector = 1 - this)
# ENGRAM_CODE_GRAPH=false          # add sym:-graph signal (boost docs naming the queried symbol)
# ENGRAM_CODE_DEF_BOOST=0.10       # additive boost for the file defining a rare query symbol (0 = off)
# ENGRAM_INDEX_TIMEOUT_SECS=120  # engram-index per-request POST/DELETE timeout (raise for large files)
ENGRAM_LLM_MODEL=qwen3
ENGRAM_VAULT_DIR=$HOME/engram/vault
# Optional: reverse SSH tunnel target used by deploy/run.sh (leave unset for local-only).
# ENGRAM_TUNNEL_HOST=user@your-gateway-host
# ENGRAM_TUNNEL_KEY=$HOME/.ssh/id_ed25519
